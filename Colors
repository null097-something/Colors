RGB() {
    if [ "$#" -ne 3 ] || [ "$1" -lt 0 ] || [ "$1" -gt 255 ] ||
       [ "$2" -lt 0 ] || [ "$2" -gt 255 ] ||
       [ "$3" -lt 0 ] || [ "$3" -gt 255 ]; then
        return 1
    fi

    printf '\033[38;2;%d;%d;%dm' "$1" "$2" "$3"
}

BG_RGB() {
    if [ "$#" -ne 3 ] || [ "$1" -lt 0 ] || [ "$1" -gt 255 ] ||
       [ "$2" -lt 0 ] || [ "$2" -gt 255 ] ||
       [ "$3" -lt 0 ] || [ "$3" -gt 255 ]; then
        return 1
    fi

    printf '\033[48;2;%d;%d;%dm' "$1" "$2" "$3"
}
RANDOM_RGB() {
    printf '\033[38;2;%d;%d;%dm' \
        "$((RANDOM % 256))" \
        "$((RANDOM % 256))" \
